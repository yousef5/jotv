{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JoTV",
  "version": "0.3.0",
  "identifier": "com.jotv.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "JoTV",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/reel-thumbs/**",
          "$APPLOCALDATA/library-images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "IPTV player for live TV, movies and series",
    "longDescription": "JoTV plays your IPTV subscription (Xtream codes or M3U): live TV with an in-app player, a movie and series library with artwork, favorites, downloads and a video library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
